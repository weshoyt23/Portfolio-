<script>
// Gallery state
const state = {};

function initGallery(id) {
  const slides = document.querySelectorAll(`#gt-${id} .gallery-slide`);
  state[id] = { current: 0, total: slides.length };
}

function slide(id, dir) {
  const s = state[id];
  if (!s) return;
  s.current = (s.current + dir + s.total) % s.total;
  update(id);
}

function goTo(id, idx) {
  if (!state[id]) return;
  state[id].current = idx;
  update(id);
}

function update(id) {
  const s = state[id];
  const track = document.getElementById(`gt-${id}`);
  const dots = document.querySelectorAll(`#gd-${id} .dot`);
  const count = document.getElementById(`gc-${id}`);
  if (track) track.style.transform = `translateX(-${s.current * 100}%)`;
  dots.forEach((d, i) => d.classList.toggle('active', i === s.current));
  if (count) count.textContent = `${s.current + 1} / ${s.total}`;
}

// Touch swipe
function addSwipe(id) {
  const gallery = document.getElementById(`g-${id}`);
  if (!gallery) return;
  let startX = 0;
  gallery.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  gallery.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) slide(id, diff > 0 ? 1 : -1);
  }, { passive: true });
}

const galleries = ['brinson','courgette','duncan','hiv','dcct','kh','bfb'];
galleries.forEach(id => { initGallery(id); addSwipe(id); });
</script>
