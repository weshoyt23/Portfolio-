<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="color-scheme" content="light only">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wesley McDaniel — Graphic Designer</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--white:#ffffff;--black:#0a0a0a;--gray:#f2f2f0;--rule:#d8d8d4;--muted:#8a8a8a;--accent:#0a0a0a}
html{scroll-behavior:smooth;background:#ffffff !important;color-scheme:light only}
body{background:#ffffff !important;color:#0a0a0a !important;font-family:'IBM Plex Sans',sans-serif;font-weight:300;line-height:1.6;font-size:15px;color-scheme:light only}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:#fff;border-bottom:1px solid var(--rule);padding:0 24px}
.nav-inner{display:flex;justify-content:space-between;align-items:center;height:52px;max-width:1100px;margin:0 auto}
.nav-name{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:#0a0a0a}
.nav-links{display:flex;gap:28px}
.nav-links a{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.15em;text-transform:uppercase;text-decoration:none;color:var(--muted);transition:color .15s}
.nav-links a:hover{color:#0a0a0a}

/* HERO */
.hero{margin-top:52px;padding:72px 24px 56px;max-width:1100px;margin-left:auto;margin-right:auto;border-bottom:2px solid #0a0a0a}
.hero-eyebrow{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:40px}
.hero-tag{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);line-height:2}
.hero-name{font-family:'Bebas Neue',sans-serif;font-size:clamp(68px,11vw,148px);letter-spacing:.02em;line-height:.88;color:#0a0a0a;margin-bottom:28px}
.hero-name span{display:block}
.hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:32px}
.hero-desc{max-width:460px;font-size:15px;font-weight:300;line-height:1.75;color:#0a0a0a}
.hero-stats{display:flex;gap:36px;flex-shrink:0}
.stat{text-align:right}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:.02em;line-height:1;color:#0a0a0a}
.stat-label{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-top:3px}

/* SECTION HDR */
.sec-hdr{display:flex;justify-content:space-between;align-items:center;padding:18px 24px;border-bottom:1px solid var(--rule);max-width:1100px;margin:0 auto}
.sec-title{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.sec-count{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted)}

/* PROJECT GRID */
.projects{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;border-left:1px solid var(--rule)}

/* PROJECT CARD */
.project{border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);background:#fff}

/* GALLERY */
.gallery{position:relative;width:100%;overflow:hidden;background:#f8f8f6;border-bottom:1px solid var(--rule);aspect-ratio:4/3}
.gallery-track{display:flex;transition:transform .35s cubic-bezier(.25,.46,.45,.94);height:100%}
.gallery-slide{min-width:100%;height:100%;flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:24px;background:#f8f8f6}
.gallery-slide img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block}
.gallery-btn{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.9);border:none;width:32px;height:32px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;color:#0a0a0a;z-index:5;-webkit-tap-highlight-color:transparent;transition:background .15s}
.gallery-btn:hover{background:#fff}
.gallery-btn.prev{left:10px}
.gallery-btn.next{right:10px}
.gallery-dots{position:absolute;bottom:10px;left:0;right:0;display:flex;justify-content:center;gap:5px}
.dot{width:5px;height:5px;border-radius:50%;background:rgba(0,0,0,.25);transition:background .2s;cursor:pointer}
.dot.active{background:#0a0a0a}
.gallery-count{position:absolute;top:10px;right:10px;font-family:'IBM Plex Mono',monospace;font-size:9px;background:rgba(255,255,255,.85);padding:2px 7px;border-radius:2px;color:#0a0a0a;letter-spacing:.08em}

/* META */
.project-meta{padding:18px 20px}
.project-year{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.15em;color:var(--muted);margin-bottom:4px}
.project-title{font-size:15px;font-weight:400;color:#0a0a0a;line-height:1.3;margin-bottom:3px}
.project-type{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.project-desc{font-size:12px;color:var(--muted);line-height:1.6;margin-top:6px}

/* ABOUT */
.about-wrap{max-width:1100px;margin:0 auto;border-top:2px solid #0a0a0a;display:grid;grid-template-columns:280px 1fr}
.about-left{padding:56px 36px 56px 24px;border-right:1px solid var(--rule)}
.about-eyebrow{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:20px}
.about-hl{font-family:'Bebas Neue',sans-serif;font-size:48px;letter-spacing:.02em;line-height:.92;color:#0a0a0a}
.about-right{padding:56px 24px 56px 40px}
.about-body{font-size:15px;font-weight:300;line-height:1.8;color:#0a0a0a;margin-bottom:20px;max-width:520px}
.skills{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--rule);margin-top:28px}
.skill{padding:13px 16px;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}
.skill:nth-child(3n){border-right:none}
.skill:nth-last-child(-n+3){border-bottom:none}
.skill-name{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#0a0a0a;margin-bottom:2px}
.skill-desc{font-size:11px;color:var(--muted);line-height:1.4}

/* CONTACT */
.contact-wrap{max-width:1100px;margin:0 auto;border-top:2px solid #0a0a0a;padding:72px 24px;display:flex;justify-content:space-between;align-items:flex-end}
.contact-eyebrow{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.contact-hl{font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,7vw,88px);letter-spacing:.02em;line-height:.9;color:#0a0a0a;margin-bottom:28px}
.contact-email{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.05em;color:#0a0a0a;text-decoration:none;border-bottom:1px solid #0a0a0a;padding-bottom:2px;transition:opacity .15s}
.contact-email:hover{opacity:.45}
.contact-loc{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);line-height:2;text-align:right}

/* FOOTER */
footer{border-top:1px solid var(--rule);padding:18px 24px;max-width:1100px;margin:0 auto;display:flex;justify-content:space-between}
.foot-txt{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.fade{opacity:0;animation:fadeUp .55s ease forwards}
.f1{animation-delay:.04s}.f2{animation-delay:.12s}.f3{animation-delay:.2s}.f4{animation-delay:.28s}

/* RESPONSIVE */
@media(max-width:700px){
  nav{padding:0 16px}
  .hero{padding:52px 16px 36px;margin-top:52px}
  .hero-name{font-size:58px}
  .hero-bottom{flex-direction:column;align-items:flex-start}
  .hero-stats{flex-direction:row}.stat{text-align:left}
  .projects{grid-template-columns:1fr}
  .project{border-right:none}
  .about-wrap{grid-template-columns:1fr}
  .about-left{border-right:none;border-bottom:1px solid var(--rule);padding:36px 16px}
  .about-right{padding:36px 16px}
  .skills{grid-template-columns:1fr 1fr}
  .skill:nth-child(3n){border-right:1px solid var(--rule)}
  .skill:nth-child(2n){border-right:none}
  .contact-wrap{flex-direction:column;align-items:flex-start;gap:28px;padding:48px 16px}
  .contact-loc{text-align:left}
  .sec-hdr{padding:14px 16px}
  footer{padding:16px}
}
</style>
